# op.env — 1Password secret *references*, never secret values. Safe to commit.
#
# Resolve at launch (token exists only for that process tree):
#   op run --env-file=op.env -- <worker command>
#
# The op:// path points at the item you create once (notes/eval-ops-design.md §2):
#   op item create --category "API Credential" --title "claude-code" \
#     --vault <vault-id> 'token[password]=<paste once>'
#
# Vault "Private" referenced by ID (stable, space-free); item by title "claude-code";
# field is the "token" password field.
CLAUDE_CODE_OAUTH_TOKEN="op://rsu5be3dxhbwf4x7b5fja76gka/claude-code/token"
